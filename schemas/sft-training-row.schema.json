{
  "$id": "https://schemas.padawan.local/v1/sft-training-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "checkpoint_id": {
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "compiler_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Compiler Version",
      "type": "string"
    },
    "eligibility_decision_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Eligibility Decision Ids",
      "type": "array"
    },
    "episode_id": {
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "final_answer": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],
      "title": "Final Answer"
    },
    "grade": {
      "additionalProperties": true,
      "title": "Grade",
      "type": "object"
    },
    "messages": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Messages",
      "type": "array"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "public_derivation": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Public Derivation"
    },
    "reward_records": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Reward Records",
      "type": "array"
    },
    "rights_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Rights Digests",
      "type": "array"
    },
    "row_id": {
      "minLength": 1,
      "title": "Row Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Evidence Refs",
      "type": "array"
    },
    "source_record_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Record Digests",
      "type": "array"
    }
  },
  "required": [
    "row_id",
    "source_evidence_refs",
    "source_record_digests",
    "episode_id",
    "attempt_id",
    "checkpoint_id",
    "messages",
    "prompt",
    "public_derivation",
    "final_answer",
    "grade",
    "reward_records",
    "eligibility_decision_ids"
  ],
  "title": "SFTTrainingRow",
  "type": "object"
}
