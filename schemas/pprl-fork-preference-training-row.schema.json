{
  "$id": "https://schemas.padawan.local/v1/pprl-fork-preference-training-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chosen_outcome": {
      "additionalProperties": true,
      "title": "Chosen Outcome",
      "type": "object"
    },
    "chosen_rollout_id": {
      "minLength": 1,
      "title": "Chosen Rollout Id",
      "type": "string"
    },
    "chosen_trajectory_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Chosen Trajectory Digest",
      "type": "string"
    },
    "compiler_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Compiler Version",
      "type": "string"
    },
    "eligibility_decision_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 2,
      "title": "Eligibility Decision Ids",
      "type": "array"
    },
    "fork_id": {
      "minLength": 1,
      "title": "Fork Id",
      "type": "string"
    },
    "parent_state_id": {
      "minLength": 1,
      "title": "Parent State Id",
      "type": "string"
    },
    "rejected_outcome": {
      "additionalProperties": true,
      "title": "Rejected Outcome",
      "type": "object"
    },
    "rejected_rollout_id": {
      "minLength": 1,
      "title": "Rejected Rollout Id",
      "type": "string"
    },
    "rejected_trajectory_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rejected Trajectory Digest",
      "type": "string"
    },
    "rights_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Rights Digests",
      "type": "array"
    },
    "row_id": {
      "minLength": 1,
      "title": "Row Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Evidence Refs",
      "type": "array"
    },
    "source_record_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Record Digests",
      "type": "array"
    }
  },
  "required": [
    "row_id",
    "source_evidence_refs",
    "source_record_digests",
    "fork_id",
    "parent_state_id",
    "chosen_rollout_id",
    "rejected_rollout_id",
    "chosen_trajectory_digest",
    "rejected_trajectory_digest",
    "chosen_outcome",
    "rejected_outcome",
    "eligibility_decision_ids"
  ],
  "title": "PPRLForkPreferenceTrainingRow",
  "type": "object"
}
