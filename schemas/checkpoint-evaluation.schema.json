{
  "$defs": {
    "HardGateResult": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/VerifierDisposition"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "gate_id": {
          "minLength": 1,
          "title": "Gate Id",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "gate_id",
        "passed",
        "disposition",
        "evidence_refs",
        "reason"
      ],
      "title": "HardGateResult",
      "type": "object"
    },
    "MetricObservation": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "metric_id": {
          "minLength": 1,
          "title": "Metric Id",
          "type": "string"
        },
        "missing_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Reason"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "metric_id",
        "value",
        "evidence_refs"
      ],
      "title": "MetricObservation",
      "type": "object"
    },
    "VerifierDisposition": {
      "enum": [
        "verified",
        "rejected",
        "unknown",
        "infrastructure_failure"
      ],
      "title": "VerifierDisposition",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/checkpoint-evaluation.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "condition_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Condition Id"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "evaluation_id": {
      "minLength": 1,
      "title": "Evaluation Id",
      "type": "string"
    },
    "hard_gates": {
      "items": {
        "$ref": "#/$defs/HardGateResult"
      },
      "minItems": 1,
      "title": "Hard Gates",
      "type": "array"
    },
    "metrics": {
      "items": {
        "$ref": "#/$defs/MetricObservation"
      },
      "minItems": 1,
      "title": "Metrics",
      "type": "array"
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "suite_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suite Manifest Digest",
      "type": "string"
    }
  },
  "required": [
    "evaluation_id",
    "checkpoint_id",
    "study_id",
    "suite_manifest_digest",
    "metrics",
    "hard_gates",
    "created_at"
  ],
  "title": "CheckpointEvaluationRecord",
  "type": "object"
}
