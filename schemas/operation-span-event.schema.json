{
  "$defs": {
    "OperationStatus": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out"
      ],
      "title": "OperationStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/operation-span-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "detail": {
      "additionalProperties": true,
      "title": "Detail",
      "type": "object"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "operation_id": {
      "minLength": 1,
      "title": "Operation Id",
      "type": "string"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "$ref": "#/$defs/OperationStatus"
    }
  },
  "required": [
    "event_id",
    "operation_id",
    "sequence",
    "status",
    "occurred_at"
  ],
  "title": "OperationSpanEventRecord",
  "type": "object"
}
