{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "artifact_refs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "evidence_id": {
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "deterministic",
            "tool",
            "trace",
            "public_step",
            "teacher",
            "system"
          ],
          "title": "Kind",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "statement",
        "payload"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "GradeOutcome": {
      "enum": [
        "correct",
        "incorrect",
        "partial",
        "invalid_process",
        "malformed",
        "infrastructure_failure",
        "grader_failure"
      ],
      "title": "GradeOutcome",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/grade.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifacts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deterministic": {
      "title": "Deterministic",
      "type": "boolean"
    },
    "error_class": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error Class"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceRecord"
      },
      "title": "Evidence",
      "type": "array"
    },
    "first_invalid_step_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "First Invalid Step Id"
    },
    "grade_id": {
      "minLength": 1,
      "title": "Grade Id",
      "type": "string"
    },
    "grader_type": {
      "minLength": 1,
      "title": "Grader Type",
      "type": "string"
    },
    "grader_version": {
      "minLength": 1,
      "title": "Grader Version",
      "type": "string"
    },
    "infrastructure_failure": {
      "default": false,
      "title": "Infrastructure Failure",
      "type": "boolean"
    },
    "outcome": {
      "$ref": "#/$defs/GradeOutcome"
    },
    "parsed_answer": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parsed Answer"
    },
    "public_step_validation": {
      "default": [],
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Public Step Validation",
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "student_failure": {
      "default": false,
      "title": "Student Failure",
      "type": "boolean"
    },
    "unsupported_claims": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Unsupported Claims",
      "type": "array"
    }
  },
  "required": [
    "grade_id",
    "attempt_id",
    "grader_type",
    "grader_version",
    "outcome",
    "score",
    "deterministic",
    "evidence",
    "created_at"
  ],
  "title": "GradeRecord",
  "type": "object"
}
