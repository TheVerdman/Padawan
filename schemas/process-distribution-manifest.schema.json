{
  "$defs": {
    "DistributionPartition": {
      "additionalProperties": false,
      "properties": {
        "contamination_scope": {
          "minLength": 1,
          "title": "Contamination Scope",
          "type": "string"
        },
        "generator_parameters": {
          "additionalProperties": true,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Generator Parameters",
          "type": "object"
        },
        "sampling_weight": {
          "exclusiveMinimum": 0.0,
          "maximum": 1.0,
          "title": "Sampling Weight",
          "type": "number"
        },
        "split": {
          "$ref": "#/$defs/ProjectSplit"
        }
      },
      "required": [
        "split",
        "sampling_weight",
        "contamination_scope"
      ],
      "title": "DistributionPartition",
      "type": "object"
    },
    "DistributionScope": {
      "enum": [
        "internal_only",
        "agreement_restricted",
        "redistributable"
      ],
      "title": "DistributionScope",
      "type": "string"
    },
    "IdentityEvidenceStatus": {
      "enum": [
        "pinned",
        "verified",
        "declared",
        "unknown"
      ],
      "title": "IdentityEvidenceStatus",
      "type": "string"
    },
    "ProjectSplit": {
      "enum": [
        "train",
        "adaptive_development",
        "validation",
        "sealed"
      ],
      "title": "ProjectSplit",
      "type": "string"
    },
    "ReplicationPolicy": {
      "additionalProperties": false,
      "description": "Minimum evidence shape for a learning or comparative claim.",
      "properties": {
        "maximum_rollouts_per_instance": {
          "minimum": 2,
          "title": "Maximum Rollouts Per Instance",
          "type": "integer"
        },
        "minimum_rollouts_per_instance": {
          "minimum": 2,
          "title": "Minimum Rollouts Per Instance",
          "type": "integer"
        },
        "minimum_unique_instances": {
          "minimum": 2,
          "title": "Minimum Unique Instances",
          "type": "integer"
        },
        "paired_checkpoint_forks": {
          "default": true,
          "title": "Paired Checkpoint Forks",
          "type": "boolean"
        }
      },
      "required": [
        "minimum_unique_instances",
        "minimum_rollouts_per_instance",
        "maximum_rollouts_per_instance"
      ],
      "title": "ReplicationPolicy",
      "type": "object"
    },
    "RightsBasis": {
      "enum": [
        "project_authored",
        "public_domain",
        "open_license",
        "contract_authorized",
        "fair_use_reviewed",
        "provider_terms",
        "unknown"
      ],
      "title": "RightsBasis",
      "type": "string"
    },
    "RightsReviewStatus": {
      "enum": [
        "confirmed",
        "review_required",
        "prohibited"
      ],
      "title": "RightsReviewStatus",
      "type": "string"
    },
    "RightsUse": {
      "enum": [
        "evidence_retention",
        "internal_research",
        "evaluation",
        "continued_pretraining",
        "sft",
        "preference",
        "rlvr",
        "process",
        "redistribution"
      ],
      "title": "RightsUse",
      "type": "string"
    },
    "SourceRights": {
      "additionalProperties": false,
      "description": "Versioned use authority; this is governance evidence, not a legal conclusion.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "basis": {
          "$ref": "#/$defs/RightsBasis"
        },
        "basis_detail": {
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "distribution_scope": {
          "$ref": "#/$defs/DistributionScope"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/RightsUse"
          },
          "title": "Permitted Uses",
          "type": "array"
        },
        "restrictions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/RightsReviewStatus"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rights_id": {
          "minLength": 1,
          "title": "Rights Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "terms_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Digest"
        },
        "terms_uri": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Uri"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rights_id",
        "version",
        "basis",
        "basis_detail",
        "permitted_uses",
        "distribution_scope",
        "review_status"
      ],
      "title": "SourceRights",
      "type": "object"
    },
    "VersionedComponentIdentity": {
      "additionalProperties": false,
      "description": "Content-bound component identity without embedding the component itself.",
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "evidence_status": {
          "$ref": "#/$defs/IdentityEvidenceStatus"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "version",
        "digest",
        "evidence_status",
        "evidence"
      ],
      "title": "VersionedComponentIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/process-distribution-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "difficulty_strata": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Difficulty Strata",
      "type": "array"
    },
    "distribution_id": {
      "minLength": 1,
      "title": "Distribution Id",
      "type": "string"
    },
    "generator": {
      "$ref": "#/$defs/VersionedComponentIdentity"
    },
    "partitions": {
      "items": {
        "$ref": "#/$defs/DistributionPartition"
      },
      "minItems": 4,
      "title": "Partitions",
      "type": "array"
    },
    "population": {
      "minLength": 1,
      "title": "Population",
      "type": "string"
    },
    "replication": {
      "$ref": "#/$defs/ReplicationPolicy"
    },
    "rights": {
      "$ref": "#/$defs/SourceRights"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "seed_namespace": {
      "minLength": 1,
      "title": "Seed Namespace",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "distribution_id",
    "version",
    "title",
    "population",
    "generator",
    "rights",
    "partitions",
    "replication",
    "difficulty_strata",
    "seed_namespace",
    "created_at"
  ],
  "title": "ProcessDistributionManifest",
  "type": "object"
}
