{
  "$defs": {
    "FailureAssignment": {
      "additionalProperties": false,
      "properties": {
        "automated": {
          "title": "Automated",
          "type": "boolean"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_result_digests": {
          "items": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Result Digests",
          "type": "array"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "proposed_by": {
          "minLength": 1,
          "title": "Proposed By",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        }
      },
      "required": [
        "node_id",
        "confidence",
        "evidence_result_digests",
        "proposed_by",
        "automated"
      ],
      "title": "FailureAssignment",
      "type": "object"
    },
    "ResearchAxis": {
      "enum": [
        "checkpoint",
        "quantization",
        "task",
        "parent_state",
        "harness",
        "continuation",
        "context_policy",
        "prompts",
        "tools",
        "budget",
        "serving",
        "auxiliary_models",
        "environment",
        "instrumentation",
        "seed"
      ],
      "title": "ResearchAxis",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "proposed",
        "admitted",
        "rejected",
        "superseded"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/atlas-failure-cluster.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignments": {
      "items": {
        "$ref": "#/$defs/FailureAssignment"
      },
      "minItems": 1,
      "title": "Assignments",
      "type": "array"
    },
    "campaign_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Campaign Digest",
      "type": "string"
    },
    "cluster_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Cluster Digest",
      "type": "string"
    },
    "cluster_id": {
      "minLength": 1,
      "title": "Cluster Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "exemplar_result_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Exemplar Result Digests",
      "type": "array"
    },
    "member_result_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Member Result Digests",
      "type": "array"
    },
    "ontology_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ontology Digest",
      "type": "string"
    },
    "probe_set_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Probe Set Digest"
    },
    "reproducibility": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Reproducibility",
      "type": "number"
    },
    "review_reason": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Review Reason"
    },
    "reviewed_by": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed By"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "severity": {
      "maximum": 5,
      "minimum": 1,
      "title": "Severity",
      "type": "integer"
    },
    "stability": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Stability",
      "type": "number"
    },
    "status": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "suspected_changed_axes": {
      "items": {
        "$ref": "#/$defs/ResearchAxis"
      },
      "title": "Suspected Changed Axes",
      "type": "array"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "cluster_id",
    "campaign_digest",
    "ontology_digest",
    "title",
    "assignments",
    "member_result_digests",
    "exemplar_result_digests",
    "reproducibility",
    "stability",
    "severity",
    "suspected_changed_axes",
    "status",
    "cluster_digest",
    "created_at"
  ],
  "title": "FailureCluster",
  "type": "object"
}
