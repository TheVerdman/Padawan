{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AtlasEvidenceDisclosurePolicy": {
      "additionalProperties": false,
      "description": "Trusted composition input; an Atlas record cannot grant itself disclosure.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "intervention_description": {
          "minLength": 1,
          "title": "Intervention Description",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "reviewer_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Reviewer Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_scopes": {
          "items": {
            "$ref": "#/$defs/AtlasEvidenceSourceScope"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Scopes",
          "type": "array"
        },
        "target_contamination_scope": {
          "minLength": 1,
          "title": "Target Contamination Scope",
          "type": "string"
        },
        "target_execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Execution Digest",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "target_execution_digest",
        "target_contamination_scope",
        "intervention_description",
        "reviewer_ids",
        "source_scopes",
        "created_at",
        "expires_at"
      ],
      "title": "AtlasEvidenceDisclosurePolicy",
      "type": "object"
    },
    "AtlasEvidenceOriginReview": {
      "additionalProperties": false,
      "properties": {
        "candidate_review_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Review Digest",
          "type": "string"
        },
        "disclosure_policy": {
          "$ref": "#/$defs/AtlasEvidenceDisclosurePolicy"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trials": {
          "items": {
            "$ref": "#/$defs/AtlasTrialEvidenceSource"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Trials",
          "type": "array"
        }
      },
      "required": [
        "candidate_review_digest",
        "disclosure_policy",
        "policy_digest",
        "trials"
      ],
      "title": "AtlasEvidenceOriginReview",
      "type": "object"
    },
    "AtlasEvidenceSourceScope": {
      "additionalProperties": false,
      "properties": {
        "campaign_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Campaign Digest",
          "type": "string"
        },
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "output_rights": {
          "$ref": "#/$defs/SourceRights"
        },
        "research_execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Research Execution Digest",
          "type": "string"
        },
        "suite_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Suite Digest",
          "type": "string"
        }
      },
      "required": [
        "campaign_digest",
        "condition_id",
        "suite_digest",
        "research_execution_digest",
        "output_rights"
      ],
      "title": "AtlasEvidenceSourceScope",
      "type": "object"
    },
    "AtlasTrialEvidenceSource": {
      "additionalProperties": false,
      "description": "Native IDs/digests for privileged reconstruction, never a worker reference.",
      "properties": {
        "context_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Context Digest",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "request_record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Record Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "result_record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Record Digest",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "result_digest",
        "result_record_digest",
        "request_id",
        "request_record_digest",
        "context_digest"
      ],
      "title": "AtlasTrialEvidenceSource",
      "type": "object"
    },
    "DistributionScope": {
      "enum": [
        "internal_only",
        "agreement_restricted",
        "redistributable"
      ],
      "title": "DistributionScope",
      "type": "string"
    },
    "EvidenceAdmissionPolicy": {
      "additionalProperties": false,
      "description": "Pinned broker configuration, supplied at composition rather than by workers.",
      "properties": {
        "maximum_bytes": {
          "exclusiveMinimum": 0,
          "title": "Maximum Bytes",
          "type": "integer"
        },
        "maximum_forensic_source_bytes": {
          "minimum": 0,
          "title": "Maximum Forensic Source Bytes",
          "type": "integer"
        },
        "maximum_forensic_sources": {
          "minimum": 0,
          "title": "Maximum Forensic Sources",
          "type": "integer"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "reviewer_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reviewer Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "reviewer_ids",
        "maximum_bytes",
        "maximum_forensic_sources",
        "maximum_forensic_source_bytes"
      ],
      "title": "EvidenceAdmissionPolicy",
      "type": "object"
    },
    "ForensicArtifactRef": {
      "additionalProperties": false,
      "description": "Researcher-only reference; never part of a worker projection.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "classification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Classification Digest",
          "type": "string"
        },
        "domain": {
          "const": "forensic",
          "default": "forensic",
          "title": "Domain",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "classification_digest"
      ],
      "title": "ForensicArtifactRef",
      "type": "object"
    },
    "ProcessArtifactRef": {
      "additionalProperties": false,
      "description": "Worker-facing reference without forensic lineage or physical storage authority.",
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "domain": {
          "const": "process",
          "default": "process",
          "title": "Domain",
          "type": "string"
        },
        "execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "process_artifact_id": {
          "pattern": "^process-artifact-[0-9a-f]{32}$",
          "title": "Process Artifact Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "process_artifact_id",
        "execution_digest",
        "content_digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ProcessArtifactRef",
      "type": "object"
    },
    "ProcessEvidenceAdmission": {
      "additionalProperties": false,
      "description": "Privileged review receipt. Only process_reference may reach workers.\n\nReview attests the exact candidate bytes and their full source set. Semantic\nredaction is a review responsibility; byte identity cannot prove it occurred.",
      "properties": {
        "admission_policy": {
          "$ref": "#/$defs/EvidenceAdmissionPolicy"
        },
        "allowed_uses": {
          "items": {
            "$ref": "#/$defs/ProcessEvidenceUse"
          },
          "minItems": 1,
          "title": "Allowed Uses",
          "type": "array"
        },
        "candidate_artifact_id": {
          "minLength": 1,
          "title": "Candidate Artifact Id",
          "type": "string"
        },
        "candidate_classification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Candidate Classification Digest",
          "type": "string"
        },
        "contamination_scope": {
          "minLength": 1,
          "title": "Contamination Scope",
          "type": "string"
        },
        "forensic_sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ForensicArtifactRef"
          },
          "title": "Forensic Sources",
          "type": "array"
        },
        "policy_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Policy Digest",
          "type": "string"
        },
        "process_reference": {
          "$ref": "#/$defs/ProcessArtifactRef"
        },
        "rationale": {
          "minLength": 1,
          "title": "Rationale",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "rights": {
          "$ref": "#/$defs/SourceRights"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "process_reference",
        "candidate_artifact_id",
        "candidate_classification_digest",
        "admission_policy",
        "policy_digest",
        "reviewer_id",
        "rationale",
        "contamination_scope",
        "rights",
        "allowed_uses",
        "reviewed_at"
      ],
      "title": "ProcessEvidenceAdmission",
      "type": "object"
    },
    "ProcessEvidenceUse": {
      "enum": [
        "process",
        "training_projection"
      ],
      "title": "ProcessEvidenceUse",
      "type": "string"
    },
    "RightsBasis": {
      "enum": [
        "project_authored",
        "public_domain",
        "open_license",
        "contract_authorized",
        "fair_use_reviewed",
        "provider_terms",
        "unknown"
      ],
      "title": "RightsBasis",
      "type": "string"
    },
    "RightsReviewStatus": {
      "enum": [
        "confirmed",
        "review_required",
        "prohibited"
      ],
      "title": "RightsReviewStatus",
      "type": "string"
    },
    "RightsUse": {
      "enum": [
        "evidence_retention",
        "internal_research",
        "evaluation",
        "continued_pretraining",
        "sft",
        "preference",
        "rlvr",
        "process",
        "redistribution"
      ],
      "title": "RightsUse",
      "type": "string"
    },
    "SourceRights": {
      "additionalProperties": false,
      "description": "Versioned use authority; this is governance evidence, not a legal conclusion.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "basis": {
          "$ref": "#/$defs/RightsBasis"
        },
        "basis_detail": {
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "distribution_scope": {
          "$ref": "#/$defs/DistributionScope"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/RightsUse"
          },
          "title": "Permitted Uses",
          "type": "array"
        },
        "restrictions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/RightsReviewStatus"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rights_id": {
          "minLength": 1,
          "title": "Rights Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "terms_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Digest"
        },
        "terms_uri": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Uri"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rights_id",
        "version",
        "basis",
        "basis_detail",
        "permitted_uses",
        "distribution_scope",
        "review_status"
      ],
      "title": "SourceRights",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/atlas-process-evidence-admission-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Version 2 retains an explicit origin without rewriting version-1 receipt bytes.",
  "properties": {
    "admitted_at": {
      "format": "date-time",
      "title": "Admitted At",
      "type": "string"
    },
    "atlas_origin": {
      "$ref": "#/$defs/AtlasEvidenceOriginReview"
    },
    "authorization_sequence": {
      "minimum": 0,
      "title": "Authorization Sequence",
      "type": "integer"
    },
    "review": {
      "$ref": "#/$defs/ProcessEvidenceAdmission"
    },
    "schema_version": {
      "const": "2.0.0",
      "default": "2.0.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "review",
    "atlas_origin",
    "authorization_sequence",
    "admitted_at"
  ],
  "title": "AtlasProcessEvidenceAdmissionRecord",
  "type": "object"
}
