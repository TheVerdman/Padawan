{
  "$defs": {
    "BudgetDisposition": {
      "enum": [
        "capped",
        "unbounded",
        "not_applicable"
      ],
      "title": "BudgetDisposition",
      "type": "string"
    },
    "BudgetLimit": {
      "additionalProperties": false,
      "properties": {
        "disposition": {
          "$ref": "#/$defs/BudgetDisposition"
        },
        "scope": {
          "minLength": 1,
          "title": "Scope",
          "type": "string"
        },
        "unit": {
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        }
      },
      "required": [
        "disposition",
        "scope",
        "unit"
      ],
      "title": "BudgetLimit",
      "type": "object"
    },
    "ContextPolicy": {
      "additionalProperties": false,
      "properties": {
        "compaction_enabled": {
          "title": "Compaction Enabled",
          "type": "boolean"
        },
        "compaction_strategy": {
          "minLength": 1,
          "title": "Compaction Strategy",
          "type": "string"
        },
        "compactor": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedComponentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "configured_context_window_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Configured Context Window Tokens"
        },
        "context_limit_evidence": {
          "minLength": 1,
          "title": "Context Limit Evidence",
          "type": "string"
        },
        "effective_input_limit_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Effective Input Limit Tokens"
        },
        "history_selection": {
          "minLength": 1,
          "title": "History Selection",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "token_counting_mode": {
          "minLength": 1,
          "title": "Token Counting Mode",
          "type": "string"
        },
        "truncation_enabled": {
          "title": "Truncation Enabled",
          "type": "boolean"
        },
        "truncation_strategy": {
          "minLength": 1,
          "title": "Truncation Strategy",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "configured_context_window_tokens",
        "effective_input_limit_tokens",
        "context_limit_evidence",
        "token_counting_mode",
        "history_selection",
        "truncation_enabled",
        "truncation_strategy",
        "compaction_enabled",
        "compaction_strategy"
      ],
      "title": "ContextPolicy",
      "type": "object"
    },
    "ContinuationPolicy": {
      "additionalProperties": false,
      "description": "Cross-request state semantics, separate from observational trace capture.",
      "properties": {
        "continuation_mode": {
          "minLength": 1,
          "title": "Continuation Mode",
          "type": "string"
        },
        "previous_response_id_enabled": {
          "title": "Previous Response Id Enabled",
          "type": "boolean"
        },
        "private_reasoning_capture_enabled": {
          "title": "Private Reasoning Capture Enabled",
          "type": "boolean"
        },
        "private_reasoning_used_as_context": {
          "title": "Private Reasoning Used As Context",
          "type": "boolean"
        },
        "reasoning_retention_enabled": {
          "title": "Reasoning Retention Enabled",
          "type": "boolean"
        },
        "reasoning_retention_mode": {
          "minLength": 1,
          "title": "Reasoning Retention Mode",
          "type": "string"
        },
        "response_storage_enabled": {
          "title": "Response Storage Enabled",
          "type": "boolean"
        }
      },
      "required": [
        "continuation_mode",
        "response_storage_enabled",
        "previous_response_id_enabled",
        "reasoning_retention_enabled",
        "reasoning_retention_mode",
        "private_reasoning_capture_enabled",
        "private_reasoning_used_as_context"
      ],
      "title": "ContinuationPolicy",
      "type": "object"
    },
    "HarnessBudgets": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "cost": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "input_tokens": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "latency": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "output_tokens": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "retries": {
          "$ref": "#/$defs/BudgetLimit"
        },
        "wall_time": {
          "$ref": "#/$defs/BudgetLimit"
        }
      },
      "required": [
        "actions",
        "input_tokens",
        "output_tokens",
        "latency",
        "wall_time",
        "retries",
        "cost"
      ],
      "title": "HarnessBudgets",
      "type": "object"
    },
    "HarnessProfile": {
      "additionalProperties": false,
      "properties": {
        "budgets": {
          "$ref": "#/$defs/HarnessBudgets"
        },
        "context": {
          "$ref": "#/$defs/ContextPolicy"
        },
        "continuation": {
          "$ref": "#/$defs/ContinuationPolicy"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "instrumentation": {
          "$ref": "#/$defs/ResearchInstrumentationSeams"
        },
        "profile_id": {
          "minLength": 1,
          "title": "Profile Id",
          "type": "string"
        },
        "prompt_templates": {
          "items": {
            "$ref": "#/$defs/VersionedComponentIdentity"
          },
          "minItems": 1,
          "title": "Prompt Templates",
          "type": "array"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tier": {
          "minLength": 1,
          "title": "Tier",
          "type": "string"
        },
        "tools": {
          "items": {
            "$ref": "#/$defs/VersionedComponentIdentity"
          },
          "minItems": 1,
          "title": "Tools",
          "type": "array"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "profile_id",
        "version",
        "tier",
        "purpose",
        "continuation",
        "context",
        "prompt_templates",
        "tools",
        "budgets",
        "created_at"
      ],
      "title": "HarnessProfile",
      "type": "object"
    },
    "IdentityEvidenceStatus": {
      "enum": [
        "pinned",
        "verified",
        "declared",
        "unknown"
      ],
      "title": "IdentityEvidenceStatus",
      "type": "string"
    },
    "InteractionAxis": {
      "enum": [
        "memory_snapshot",
        "rendered_context",
        "sampling",
        "student_target",
        "system_prompt",
        "tools"
      ],
      "title": "InteractionAxis",
      "type": "string"
    },
    "InteractionConsentSnapshot": {
      "additionalProperties": false,
      "properties": {
        "consent_event_id": {
          "minLength": 1,
          "title": "Consent Event Id",
          "type": "string"
        },
        "memory_mode": {
          "const": "disabled",
          "default": "disabled",
          "title": "Memory Mode",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "research_trace_consent": {
          "title": "Research Trace Consent",
          "type": "boolean"
        },
        "retention_classification": {
          "$ref": "#/$defs/InteractionRetentionClass"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "training_candidate_mode": {
          "const": "not_admitted",
          "default": "not_admitted",
          "title": "Training Candidate Mode",
          "type": "string"
        }
      },
      "required": [
        "consent_event_id",
        "sequence",
        "retention_classification",
        "research_trace_consent",
        "recorded_at"
      ],
      "title": "InteractionConsentSnapshot",
      "type": "object"
    },
    "InteractionMode": {
      "enum": [
        "message",
        "branch",
        "retry",
        "replay"
      ],
      "title": "InteractionMode",
      "type": "string"
    },
    "InteractionRetentionClass": {
      "enum": [
        "personal_deletable",
        "consented_research_evidence"
      ],
      "title": "InteractionRetentionClass",
      "type": "string"
    },
    "ModelServingIdentity": {
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "$ref": "#/$defs/VersionedComponentIdentity"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "protocol": {
          "minLength": 1,
          "title": "Protocol",
          "type": "string"
        },
        "purpose": {
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "quantization": {
          "$ref": "#/$defs/VersionedComponentIdentity"
        },
        "research_role": {
          "$ref": "#/$defs/ResearchRole"
        },
        "runtime": {
          "$ref": "#/$defs/VersionedComponentIdentity"
        },
        "runtime_parameters": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "propertyNames": {
            "minLength": 1
          },
          "title": "Runtime Parameters",
          "type": "object"
        },
        "runtime_parameters_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Runtime Parameters Digest",
          "type": "string"
        },
        "serving_artifact": {
          "$ref": "#/$defs/VersionedComponentIdentity"
        },
        "transport_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedComponentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "purpose",
        "research_role",
        "model_id",
        "checkpoint",
        "quantization",
        "runtime",
        "serving_artifact",
        "protocol",
        "runtime_parameters",
        "runtime_parameters_digest"
      ],
      "title": "ModelServingIdentity",
      "type": "object"
    },
    "ResearchInstrumentationSeams": {
      "additionalProperties": false,
      "description": "Typed extension points; absence means the later phase is not implemented.",
      "properties": {
        "capability_atlas_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedComponentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "checkpoint_evaluation_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedComponentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "interactive_trajectory_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedComponentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "mechanistic_telemetry_schema": {
          "anyOf": [
            {
              "$ref": "#/$defs/VersionedComponentIdentity"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "ResearchInstrumentationSeams",
      "type": "object"
    },
    "ResearchRole": {
      "enum": [
        "target",
        "baseline",
        "teacher",
        "verifier",
        "adjudicator"
      ],
      "title": "ResearchRole",
      "type": "string"
    },
    "SamplingConfiguration": {
      "additionalProperties": false,
      "properties": {
        "max_output_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Output Tokens",
          "type": "integer"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stop": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Stop",
          "type": "array"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "top_logprobs": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Logprobs"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "required": [
        "max_output_tokens"
      ],
      "title": "SamplingConfiguration",
      "type": "object"
    },
    "SelectedHistoryMessage": {
      "additionalProperties": false,
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "message_id": {
          "minLength": 1,
          "title": "Message Id",
          "type": "string"
        },
        "parent_message_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Message Id"
        },
        "role": {
          "enum": [
            "user",
            "assistant"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "message_id",
        "role",
        "content_digest"
      ],
      "title": "SelectedHistoryMessage",
      "type": "object"
    },
    "ServingPathIdentity": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/VersionedComponentIdentity"
          },
          "minItems": 1,
          "title": "Components",
          "type": "array"
        },
        "endpoint_origin": {
          "pattern": "^https?://[^\\s]+$",
          "title": "Endpoint Origin",
          "type": "string"
        },
        "previous_response_id_enabled": {
          "const": false,
          "default": false,
          "title": "Previous Response Id Enabled",
          "type": "boolean"
        },
        "protocol": {
          "minLength": 1,
          "title": "Protocol",
          "type": "string"
        },
        "response_storage_enabled": {
          "const": false,
          "default": false,
          "title": "Response Storage Enabled",
          "type": "boolean"
        },
        "route": {
          "pattern": "^/[^\\s]*$",
          "title": "Route",
          "type": "string"
        },
        "server_side_authentication": {
          "const": true,
          "default": true,
          "title": "Server Side Authentication",
          "type": "boolean"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "endpoint_origin",
        "route",
        "protocol",
        "components"
      ],
      "title": "ServingPathIdentity",
      "type": "object"
    },
    "StudentTargetDescriptor": {
      "additionalProperties": false,
      "properties": {
        "configured_context_window_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Configured Context Window Tokens"
        },
        "display_name": {
          "minLength": 1,
          "title": "Display Name",
          "type": "string"
        },
        "effective_input_limit_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Input Limit Tokens"
        },
        "model": {
          "$ref": "#/$defs/ModelServingIdentity"
        },
        "private_reasoning_capture_enabled": {
          "title": "Private Reasoning Capture Enabled",
          "type": "boolean"
        },
        "provider": {
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "serving_path": {
          "$ref": "#/$defs/ServingPathIdentity"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "display_name",
        "provider",
        "model",
        "serving_path",
        "private_reasoning_capture_enabled"
      ],
      "title": "StudentTargetDescriptor",
      "type": "object"
    },
    "VersionedComponentIdentity": {
      "additionalProperties": false,
      "description": "Content-bound component identity without embedding the component itself.",
      "properties": {
        "component_id": {
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "evidence_status": {
          "$ref": "#/$defs/IdentityEvidenceStatus"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "version",
        "digest",
        "evidence_status",
        "evidence"
      ],
      "title": "VersionedComponentIdentity",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/exploratory-interaction-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actual_axis_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InteractionAxis"
      },
      "title": "Actual Axis Changes",
      "type": "array"
    },
    "comparison_source_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparison Source Manifest Digest"
    },
    "comparison_source_trace_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comparison Source Trace Id"
    },
    "consent": {
      "$ref": "#/$defs/InteractionConsentSnapshot"
    },
    "controlled_benchmark_eligible": {
      "const": false,
      "default": false,
      "title": "Controlled Benchmark Eligible",
      "type": "boolean"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "declared_axis_changes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/InteractionAxis"
      },
      "title": "Declared Axis Changes",
      "type": "array"
    },
    "evidence_class": {
      "const": "exploratory_not_controlled_benchmark",
      "default": "exploratory_not_controlled_benchmark",
      "title": "Evidence Class",
      "type": "string"
    },
    "harness_profile": {
      "$ref": "#/$defs/HarnessProfile"
    },
    "input_message_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Input Message Digest",
      "type": "string"
    },
    "memory_snapshot_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Memory Snapshot Digest"
    },
    "mode": {
      "$ref": "#/$defs/InteractionMode"
    },
    "parent_manifest_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Manifest Digest"
    },
    "parent_turn_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Turn Id"
    },
    "rendered_context_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rendered Context Digest",
      "type": "string"
    },
    "retention_classification": {
      "$ref": "#/$defs/InteractionRetentionClass"
    },
    "sampling": {
      "$ref": "#/$defs/SamplingConfiguration"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_history": {
      "items": {
        "$ref": "#/$defs/SelectedHistoryMessage"
      },
      "title": "Selected History",
      "type": "array"
    },
    "selected_history_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Selected History Digest",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "system_prompt": {
      "$ref": "#/$defs/VersionedComponentIdentity"
    },
    "target": {
      "$ref": "#/$defs/StudentTargetDescriptor"
    },
    "tools": {
      "items": {
        "$ref": "#/$defs/VersionedComponentIdentity"
      },
