{
  "$id": "https://schemas.padawan.local/v1/process-observation-policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Policy Digest",
      "type": "string"
    },
    "maximum_bytes": {
      "default": 1100000,
      "exclusiveMinimum": 0,
      "title": "Maximum Bytes",
      "type": "integer"
    },
    "observation_schema_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Observation Schema Digest",
      "type": "string"
    },
    "policy_id": {
      "minLength": 1,
      "title": "Policy Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "use": {
      "const": "worker_observation",
      "default": "worker_observation",
      "title": "Use",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "policy_id",
    "version",
    "observation_schema_digest",
    "content_policy_digest"
  ],
  "title": "ProcessObservationPolicy",
  "type": "object"
}
