{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "TrainingLane": {
      "enum": [
        "continued_pretraining",
        "sft",
        "preference",
        "rlvr",
        "process",
        "evaluation_only"
      ],
      "title": "TrainingLane",
      "type": "string"
    },
    "TrainingProductKind": {
      "enum": [
        "authored_sft",
        "evidence_ledger",
        "normalized_episodes",
        "sft",
        "preference",
        "rlvr",
        "negative_process",
        "continued_pretraining",
        "sealed_evaluation",
        "exclusions"
      ],
      "title": "TrainingProductKind",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/training-product-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/TrainingProductKind"
    },
    "row_count": {
      "minimum": 0,
      "title": "Row Count",
      "type": "integer"
    },
    "row_schema": {
      "minLength": 1,
      "title": "Row Schema",
      "type": "string"
    },
    "row_schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Row Schema Version",
      "type": "string"
    },
    "training_lane": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrainingLane"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "kind",
    "training_lane",
    "row_schema",
    "artifact",
    "row_count",
    "content_digest"
  ],
  "title": "TrainingProductManifest",
  "type": "object"
}
