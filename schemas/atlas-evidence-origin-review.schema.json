{
  "$defs": {
    "AtlasEvidenceDisclosurePolicy": {
      "additionalProperties": false,
      "description": "Trusted composition input; an Atlas record cannot grant itself disclosure.",
      "properties": {
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "intervention_description": {
          "minLength": 1,
          "title": "Intervention Description",
          "type": "string"
        },
        "policy_id": {
          "minLength": 1,
          "title": "Policy Id",
          "type": "string"
        },
        "reviewer_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Reviewer Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_scopes": {
          "items": {
            "$ref": "#/$defs/AtlasEvidenceSourceScope"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Source Scopes",
          "type": "array"
        },
        "target_contamination_scope": {
          "minLength": 1,
          "title": "Target Contamination Scope",
          "type": "string"
        },
        "target_execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Target Execution Digest",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "policy_id",
        "version",
        "target_execution_digest",
        "target_contamination_scope",
        "intervention_description",
        "reviewer_ids",
        "source_scopes",
        "created_at",
        "expires_at"
      ],
      "title": "AtlasEvidenceDisclosurePolicy",
      "type": "object"
    },
    "AtlasEvidenceSourceScope": {
      "additionalProperties": false,
      "properties": {
        "campaign_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Campaign Digest",
          "type": "string"
        },
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "output_rights": {
          "$ref": "#/$defs/SourceRights"
        },
        "research_execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Research Execution Digest",
          "type": "string"
        },
        "suite_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Suite Digest",
          "type": "string"
        }
      },
      "required": [
        "campaign_digest",
        "condition_id",
        "suite_digest",
        "research_execution_digest",
        "output_rights"
      ],
      "title": "AtlasEvidenceSourceScope",
      "type": "object"
    },
    "AtlasTrialEvidenceSource": {
      "additionalProperties": false,
      "description": "Native IDs/digests for privileged reconstruction, never a worker reference.",
      "properties": {
        "context_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Context Digest",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "request_record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Request Record Digest",
          "type": "string"
        },
        "result_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Digest",
          "type": "string"
        },
        "result_id": {
          "minLength": 1,
          "title": "Result Id",
          "type": "string"
        },
        "result_record_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Result Record Digest",
          "type": "string"
        }
      },
      "required": [
        "result_id",
        "result_digest",
        "result_record_digest",
        "request_id",
        "request_record_digest",
        "context_digest"
      ],
      "title": "AtlasTrialEvidenceSource",
      "type": "object"
    },
    "DistributionScope": {
      "enum": [
        "internal_only",
        "agreement_restricted",
        "redistributable"
      ],
      "title": "DistributionScope",
      "type": "string"
    },
    "RightsBasis": {
      "enum": [
        "project_authored",
        "public_domain",
        "open_license",
        "contract_authorized",
        "fair_use_reviewed",
        "provider_terms",
        "unknown"
      ],
      "title": "RightsBasis",
      "type": "string"
    },
    "RightsReviewStatus": {
      "enum": [
        "confirmed",
        "review_required",
        "prohibited"
      ],
      "title": "RightsReviewStatus",
      "type": "string"
    },
    "RightsUse": {
      "enum": [
        "evidence_retention",
        "internal_research",
        "evaluation",
        "continued_pretraining",
        "sft",
        "preference",
        "rlvr",
        "process",
        "redistribution"
      ],
      "title": "RightsUse",
      "type": "string"
    },
    "SourceRights": {
      "additionalProperties": false,
      "description": "Versioned use authority; this is governance evidence, not a legal conclusion.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "basis": {
          "$ref": "#/$defs/RightsBasis"
        },
        "basis_detail": {
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "distribution_scope": {
          "$ref": "#/$defs/DistributionScope"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/RightsUse"
          },
          "title": "Permitted Uses",
          "type": "array"
        },
        "restrictions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/RightsReviewStatus"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rights_id": {
          "minLength": 1,
          "title": "Rights Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "terms_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Digest"
        },
        "terms_uri": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Uri"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rights_id",
        "version",
        "basis",
        "basis_detail",
        "permitted_uses",
        "distribution_scope",
        "review_status"
      ],
      "title": "SourceRights",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/atlas-evidence-origin-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_review_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Candidate Review Digest",
      "type": "string"
    },
    "disclosure_policy": {
      "$ref": "#/$defs/AtlasEvidenceDisclosurePolicy"
    },
    "policy_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Policy Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "trials": {
      "items": {
        "$ref": "#/$defs/AtlasTrialEvidenceSource"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Trials",
      "type": "array"
    }
  },
  "required": [
    "candidate_review_digest",
    "disclosure_policy",
    "policy_digest",
    "trials"
  ],
  "title": "AtlasEvidenceOriginReview",
  "type": "object"
}
