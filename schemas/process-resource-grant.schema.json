{
  "$defs": {
    "ProcessModelRate": {
      "additionalProperties": false,
      "properties": {
        "input_micro_usd_per_million_tokens": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Input Micro Usd Per Million Tokens",
          "type": "integer"
        },
        "output_micro_usd_per_million_tokens": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Output Micro Usd Per Million Tokens",
          "type": "integer"
        },
        "rate_id": {
          "minLength": 1,
          "title": "Rate Id",
          "type": "string"
        },
        "request_micro_usd": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Request Micro Usd",
          "type": "integer"
        },
        "worker_model_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Worker Model Digest",
          "type": "string"
        }
      },
      "required": [
        "rate_id",
        "worker_model_digest",
        "input_micro_usd_per_million_tokens",
        "output_micro_usd_per_million_tokens",
        "request_micro_usd"
      ],
      "title": "ProcessModelRate",
      "type": "object"
    },
    "ProcessResources": {
      "additionalProperties": false,
      "properties": {
        "action_microseconds": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Action Microseconds",
          "type": "integer"
        },
        "actions": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Actions",
          "type": "integer"
        },
        "artifact_bytes": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "micro_usd": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Micro Usd",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "maximum": 9223372036854775807,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "title": "ProcessResources",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/process-resource-grant.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_accounting": {
      "const": "logical_allowance",
      "default": "logical_allowance",
      "title": "Artifact Accounting",
      "type": "string"
    },
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "capacity": {
      "$ref": "#/$defs/ProcessResources"
    },
    "concurrent_reservations": {
      "maximum": 9223372036854775807,
      "minimum": 1,
      "title": "Concurrent Reservations",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "currency": {
      "const": "USD",
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "grant_id": {
      "minLength": 1,
      "title": "Grant Id",
      "type": "string"
    },
    "model_rates": {
      "items": {
        "$ref": "#/$defs/ProcessModelRate"
      },
      "title": "Model Rates",
      "type": "array"
    },
    "review_evidence": {
      "minLength": 1,
      "title": "Review Evidence",
      "type": "string"
    },
    "reviewed_by": {
      "minLength": 1,
      "title": "Reviewed By",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "time_accounting": {
      "const": "reserved_action_time",
      "default": "reserved_action_time",
      "title": "Time Accounting",
      "type": "string"
    },
    "token_evidence": {
      "const": "provider_reported",
      "default": "provider_reported",
      "title": "Token Evidence",
      "type": "string"
    }
  },
  "required": [
    "grant_id",
    "authorization_digest",
    "capacity",
    "concurrent_reservations",
    "model_rates",
    "reviewed_by",
    "review_evidence",
    "created_at"
  ],
  "title": "ProcessResourceGrant",
  "type": "object"
}
