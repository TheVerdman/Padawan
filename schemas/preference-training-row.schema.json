{
  "$id": "https://schemas.padawan.local/v1/preference-training-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checkpoint_id": {
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "chosen": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],
      "title": "Chosen"
    },
    "chosen_attempt_id": {
      "minLength": 1,
      "title": "Chosen Attempt Id",
      "type": "string"
    },
    "chosen_grade": {
      "additionalProperties": true,
      "title": "Chosen Grade",
      "type": "object"
    },
    "compiler_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Compiler Version",
      "type": "string"
    },
    "eligibility_decision_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Eligibility Decision Ids",
      "type": "array"
    },
    "episode_id": {
      "minLength": 1,
      "title": "Episode Id",
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "rejected": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],
      "title": "Rejected"
    },
    "rejected_attempt_id": {
      "minLength": 1,
      "title": "Rejected Attempt Id",
      "type": "string"
    },
    "rejected_grade": {
      "additionalProperties": true,
      "title": "Rejected Grade",
      "type": "object"
    },
    "rights_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Rights Digests",
      "type": "array"
    },
    "row_id": {
      "minLength": 1,
      "title": "Row Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Evidence Refs",
      "type": "array"
    },
    "source_record_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Record Digests",
      "type": "array"
    }
  },
  "required": [
    "row_id",
    "source_evidence_refs",
    "source_record_digests",
    "episode_id",
    "checkpoint_id",
    "prompt",
    "chosen_attempt_id",
    "rejected_attempt_id",
    "chosen",
    "rejected",
    "chosen_grade",
    "rejected_grade",
    "eligibility_decision_ids"
  ],
  "title": "PreferenceTrainingRow",
  "type": "object"
}
