{
  "$id": "https://schemas.padawan.local/v1/pprl-trajectory-training-row.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "compiler_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Compiler Version",
      "type": "string"
    },
    "distribution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Distribution Digest",
      "type": "string"
    },
    "eligibility_decision_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Eligibility Decision Ids",
      "type": "array"
    },
    "events": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Events",
      "type": "array"
    },
    "execution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Digest",
      "type": "string"
    },
    "initial_state": {
      "additionalProperties": true,
      "title": "Initial State",
      "type": "object"
    },
    "instance_id": {
      "minLength": 1,
      "title": "Instance Id",
      "type": "string"
    },
    "outcomes": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Outcomes",
      "type": "array"
    },
    "process_policy": {
      "additionalProperties": true,
      "title": "Process Policy",
      "type": "object"
    },
    "program_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Program Digest",
      "type": "string"
    },
    "replication_index": {
      "minimum": 0,
      "title": "Replication Index",
      "type": "integer"
    },
    "rights_digests": {
      "default": [],
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Rights Digests",
      "type": "array"
    },
    "rollout_id": {
      "minLength": 1,
      "title": "Rollout Id",
      "type": "string"
    },
    "row_id": {
      "minLength": 1,
      "title": "Row Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Evidence Refs",
      "type": "array"
    },
    "source_record_digests": {
      "items": {
        "pattern": "^sha256:[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Record Digests",
      "type": "array"
    },
    "split": {
      "minLength": 1,
      "title": "Split",
      "type": "string"
    },
    "terminal_state": {
      "additionalProperties": true,
      "title": "Terminal State",
      "type": "object"
    },
    "worker_models": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "minItems": 1,
      "title": "Worker Models",
      "type": "array"
    }
  },
  "required": [
    "row_id",
    "source_evidence_refs",
    "source_record_digests",
    "rollout_id",
    "execution_digest",
    "program_digest",
    "distribution_digest",
    "instance_id",
    "split",
    "replication_index",
    "process_policy",
    "worker_models",
    "initial_state",
    "events",
    "terminal_state",
    "outcomes",
    "eligibility_decision_ids"
  ],
  "title": "PPRLTrajectoryTrainingRow",
  "type": "object"
}
