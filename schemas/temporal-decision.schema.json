{
  "$defs": {
    "DurationForecast": {
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "minLength": 1,
          "title": "Operation Id",
          "type": "string"
        },
        "p50_completed_at": {
          "format": "date-time",
          "title": "P50 Completed At",
          "type": "string"
        },
        "p90_completed_at": {
          "format": "date-time",
          "title": "P90 Completed At",
          "type": "string"
        },
        "source_profile_id": {
          "minLength": 1,
          "title": "Source Profile Id",
          "type": "string"
        }
      },
      "required": [
        "operation_id",
        "p50_completed_at",
        "p90_completed_at",
        "source_profile_id"
      ],
      "title": "DurationForecast",
      "type": "object"
    },
    "TemporalAction": {
      "additionalProperties": false,
      "properties": {
        "execute_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Execute At"
        },
        "kind": {
          "$ref": "#/$defs/TemporalActionKind"
        },
        "rationale_code": {
          "minLength": 1,
          "title": "Rationale Code",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject",
        "rationale_code"
      ],
      "title": "TemporalAction",
      "type": "object"
    },
    "TemporalActionKind": {
      "enum": [
        "continue",
        "wait",
        "poll",
        "revalidate",
        "inspect",
        "retry",
        "cancel",
        "reschedule",
        "notify_user"
      ],
      "title": "TemporalActionKind",
      "type": "string"
    },
    "TemporalContinuity": {
      "enum": [
        "immediate_continuation",
        "resume_after_gap",
        "reestablish_context"
      ],
      "title": "TemporalContinuity",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/temporal-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acknowledge_gap": {
      "title": "Acknowledge Gap",
      "type": "boolean"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/TemporalAction"
      },
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "claims_continuous_activity": {
      "title": "Claims Continuous Activity",
      "type": "boolean"
    },
    "continuity": {
      "$ref": "#/$defs/TemporalContinuity"
    },
    "duration_forecasts": {
      "default": [],
      "items": {
        "$ref": "#/$defs/DurationForecast"
      },
      "title": "Duration Forecasts",
      "type": "array"
    },
    "next_check_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Check At"
    },
    "response": {
      "minLength": 1,
      "title": "Response",
      "type": "string"
    }
  },
  "required": [
    "continuity",
    "acknowledge_gap",
    "claims_continuous_activity",
    "actions",
    "response"
  ],
  "title": "TemporalDecision",
  "type": "object"
}
