{
  "$defs": {
    "AccessClassification": {
      "enum": [
        "local",
        "registration_only",
        "requires_approval",
        "unavailable",
        "legally_unclear"
      ],
      "title": "AccessClassification",
      "type": "string"
    },
    "ContaminationClassification": {
      "enum": [
        "unassessed",
        "no_known_exposure",
        "suspected",
        "confirmed"
      ],
      "title": "ContaminationClassification",
      "type": "string"
    },
    "DistributionScope": {
      "enum": [
        "internal_only",
        "agreement_restricted",
        "redistributable"
      ],
      "title": "DistributionScope",
      "type": "string"
    },
    "EvaluationClass": {
      "enum": [
        "development",
        "adaptive_search",
        "challenge",
        "sealed_promotion"
      ],
      "title": "EvaluationClass",
      "type": "string"
    },
    "RedistributionClassification": {
      "enum": [
        "permitted",
        "metadata_only",
        "prohibited",
        "unknown"
      ],
      "title": "RedistributionClassification",
      "type": "string"
    },
    "RightsBasis": {
      "enum": [
        "project_authored",
        "public_domain",
        "open_license",
        "contract_authorized",
        "fair_use_reviewed",
        "provider_terms",
        "unknown"
      ],
      "title": "RightsBasis",
      "type": "string"
    },
    "RightsReviewStatus": {
      "enum": [
        "confirmed",
        "review_required",
        "prohibited"
      ],
      "title": "RightsReviewStatus",
      "type": "string"
    },
    "RightsUse": {
      "enum": [
        "evidence_retention",
        "internal_research",
        "evaluation",
        "continued_pretraining",
        "sft",
        "preference",
        "rlvr",
        "process",
        "redistribution"
      ],
      "title": "RightsUse",
      "type": "string"
    },
    "SourceRights": {
      "additionalProperties": false,
      "description": "Versioned use authority; this is governance evidence, not a legal conclusion.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "basis": {
          "$ref": "#/$defs/RightsBasis"
        },
        "basis_detail": {
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "distribution_scope": {
          "$ref": "#/$defs/DistributionScope"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/RightsUse"
          },
          "title": "Permitted Uses",
          "type": "array"
        },
        "restrictions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/RightsReviewStatus"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rights_id": {
          "minLength": 1,
          "title": "Rights Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "terms_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Digest"
        },
        "terms_uri": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Uri"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rights_id",
        "version",
        "basis",
        "basis_detail",
        "permitted_uses",
        "distribution_scope",
        "review_status"
      ],
      "title": "SourceRights",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/atlas-dataset-governance.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "access": {
      "$ref": "#/$defs/AccessClassification"
    },
    "access_requirements": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Access Requirements",
      "type": "array"
    },
    "benchmark_id": {
      "minLength": 1,
      "title": "Benchmark Id",
      "type": "string"
    },
    "benchmark_version": {
      "minLength": 1,
      "title": "Benchmark Version",
      "type": "string"
    },
    "contamination": {
      "$ref": "#/$defs/ContaminationClassification"
    },
    "contamination_evidence": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Contamination Evidence",
      "type": "array"
    },
    "dataset_revision": {
      "minLength": 1,
      "title": "Dataset Revision",
      "type": "string"
    },
    "evaluation_class": {
      "$ref": "#/$defs/EvaluationClass"
    },
    "governance_id": {
      "minLength": 1,
      "title": "Governance Id",
      "type": "string"
    },
    "license_expression": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License Expression"
    },
    "redistribution": {
      "$ref": "#/$defs/RedistributionClassification"
    },
    "redistribution_notes": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Redistribution Notes",
      "type": "array"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/SourceRights"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sealed_handling": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Sealed Handling",
      "type": "array"
    },
    "source_url": {
      "pattern": "^https://[^\\s]+$",
      "title": "Source Url",
      "type": "string"
    }
  },
  "required": [
    "governance_id",
    "benchmark_id",
    "benchmark_version",
    "dataset_revision",
    "source_url",
    "rights",
    "access",
    "redistribution",
    "contamination",
    "evaluation_class",
    "reviewed_at"
  ],
  "title": "DatasetGovernance",
  "type": "object"
}
