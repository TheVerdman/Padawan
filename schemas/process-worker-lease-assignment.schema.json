{
  "$id": "https://schemas.padawan.local/v1/process-worker-lease-assignment.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assignment_id": {
      "pattern": "^worker-assignment-[0-9a-f]{32}$",
      "title": "Assignment Id",
      "type": "string"
    },
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "execution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Digest",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "lease_token_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Token Digest",
      "type": "string"
    },
    "registration_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Registration Digest",
      "type": "string"
    },
    "role_id": {
      "minLength": 1,
      "title": "Role Id",
      "type": "string"
    },
    "rollout_id": {
      "minLength": 1,
      "title": "Rollout Id",
      "type": "string"
    },
    "rollout_sequence": {
      "minimum": 0,
      "title": "Rollout Sequence",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Digest",
      "type": "string"
    },
    "state_id": {
      "minLength": 1,
      "title": "State Id",
      "type": "string"
    },
    "worker_id": {
      "minLength": 1,
      "title": "Worker Id",
      "type": "string"
    },
    "worker_model_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Worker Model Digest",
      "type": "string"
    }
  },
  "required": [
    "assignment_id",
    "worker_id",
    "registration_digest",
    "execution_digest",
    "authorization_digest",
    "role_id",
    "worker_model_digest",
    "rollout_id",
    "rollout_sequence",
    "state_id",
    "state_digest",
    "lease_token_digest",
    "created_at",
    "expires_at"
  ],
  "title": "ProcessWorkerLeaseAssignment",
  "type": "object"
}
