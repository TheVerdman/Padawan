{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ForensicArtifactRef": {
      "additionalProperties": false,
      "description": "Researcher-only reference; never part of a worker projection.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "classification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Classification Digest",
          "type": "string"
        },
        "domain": {
          "const": "forensic",
          "default": "forensic",
          "title": "Domain",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "classification_digest"
      ],
      "title": "ForensicArtifactRef",
      "type": "object"
    },
    "ProcessRecoveryEffect": {
      "additionalProperties": false,
      "properties": {
        "after_phase": {
          "enum": [
            "reserved",
            "started",
            "settled",
            "released"
          ],
          "title": "After Phase",
          "type": "string"
        },
        "after_resource_event_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "After Resource Event Digest",
          "type": "string"
        },
        "before_phase": {
          "enum": [
            "reserved",
            "started",
            "settled",
            "released"
          ],
          "title": "Before Phase",
          "type": "string"
        },
        "before_resource_event_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Before Resource Event Digest",
          "type": "string"
        },
        "decision_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Decision Digest",
          "type": "string"
        },
        "decision_id": {
          "minLength": 1,
          "title": "Decision Id",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "released_unstarted",
            "completed_unadmitted",
            "unknown"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "invocation_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Invocation Id"
        },
        "kind": {
          "enum": [
            "generic",
            "model",
            "container"
          ],
          "title": "Kind",
          "type": "string"
        },
        "observation_binding_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Binding Digest"
        },
        "observed_status": {
          "minLength": 1,
          "title": "Observed Status",
          "type": "string"
        },
        "reservation_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reservation Digest",
          "type": "string"
        },
        "result_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Digest"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ProcessRecoverySource"
          },
          "title": "Sources",
          "type": "array"
        },
        "worker_binding_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Worker Binding Digest"
        },
        "workload_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Workload Digest"
        }
      },
      "required": [
        "decision_id",
        "decision_digest",
        "reservation_digest",
        "before_phase",
        "after_phase",
        "before_resource_event_digest",
        "after_resource_event_digest",
        "disposition",
        "kind",
        "observed_status"
      ],
      "title": "ProcessRecoveryEffect",
      "type": "object"
    },
    "ProcessRecoveryRequest": {
      "additionalProperties": false,
      "properties": {
        "expected_lease_token_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Lease Token Digest"
        },
        "expected_state_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Expected State Digest",
          "type": "string"
        },
        "maximum_effects": {
          "default": 64,
          "maximum": 1024,
          "minimum": 1,
          "title": "Maximum Effects",
          "type": "integer"
        },
        "maximum_source_bytes": {
          "default": 16777216,
          "maximum": 134217728,
          "minimum": 1,
          "title": "Maximum Source Bytes",
          "type": "integer"
        },
        "reason": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "recovery_id": {
          "pattern": "^process-recovery-[0-9a-f]{32}$",
          "title": "Recovery Id",
          "type": "string"
        },
        "resume": {
          "default": false,
          "title": "Resume",
          "type": "boolean"
        },
        "retire_worker": {
          "default": true,
          "title": "Retire Worker",
          "type": "boolean"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "reviewer_id": {
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "rollout_id": {
          "minLength": 1,
          "title": "Rollout Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "recovery_id",
        "rollout_id",
        "expected_state_digest",
        "expected_lease_token_digest",
        "reviewer_id",
        "reason",
        "reviewed_at"
      ],
      "title": "ProcessRecoveryRequest",
      "type": "object"
    },
    "ProcessRecoverySource": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "owner_type": {
          "minLength": 1,
          "title": "Owner Type",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ForensicArtifactRef"
        }
      },
      "required": [
        "reference",
        "owner_type",
        "owner_id"
      ],
      "title": "ProcessRecoverySource",
      "type": "object"
    },
    "RolloutStatus": {
      "enum": [
        "planned",
        "active",
        "paused",
        "review_required",
        "complete",
        "failed",
        "quarantined",
        "cancelled"
      ],
      "title": "RolloutStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/process-recovery-receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "account_after_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Account After Digest",
      "type": "string"
    },
    "account_before_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Account Before Digest",
      "type": "string"
    },
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "authorization_event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Event Digest",
      "type": "string"
    },
    "authorization_sequence": {
      "minimum": 0,
      "title": "Authorization Sequence",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "ready",
        "paused",
        "review_required"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "effects": {
      "items": {
        "$ref": "#/$defs/ProcessRecoveryEffect"
      },
      "title": "Effects",
      "type": "array"
    },
    "execution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Digest",
      "type": "string"
    },
    "previous_assignment_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Assignment Digest"
    },
    "previous_worker_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Worker Id"
    },
    "request": {
      "$ref": "#/$defs/ProcessRecoveryRequest"
    },
    "request_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Request Digest",
      "type": "string"
    },
    "retired_worker_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retired Worker Digest"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "state_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Digest",
      "type": "string"
    },
    "state_id": {
      "minLength": 1,
      "title": "State Id",
      "type": "string"
    },
    "status_after": {
      "$ref": "#/$defs/RolloutStatus"
    },
    "status_before": {
      "$ref": "#/$defs/RolloutStatus"
    }
  },
  "required": [
    "request",
    "request_digest",
    "execution_digest",
    "authorization_digest",
    "authorization_sequence",
    "authorization_event_digest",
    "state_id",
    "state_digest",
    "previous_worker_id",
    "status_before",
    "status_after",
    "disposition",
    "effects",
    "account_before_digest",
    "account_after_digest",
    "created_at"
  ],
  "title": "ProcessRecoveryReceipt",
  "type": "object"
}
