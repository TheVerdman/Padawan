{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "VerifierDisposition": {
      "enum": [
        "verified",
        "rejected",
        "unknown",
        "infrastructure_failure"
      ],
      "title": "VerifierDisposition",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/verifier-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "deterministic": {
      "title": "Deterministic",
      "type": "boolean"
    },
    "disposition": {
      "$ref": "#/$defs/VerifierDisposition"
    },
    "evidence": {
      "additionalProperties": true,
      "title": "Evidence",
      "type": "object"
    },
    "scope": {
      "minLength": 1,
      "title": "Scope",
      "type": "string"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "verifier_id": {
      "minLength": 1,
      "title": "Verifier Id",
      "type": "string"
    },
    "verifier_version": {
      "minLength": 1,
      "title": "Verifier Version",
      "type": "string"
    }
  },
  "required": [
    "verifier_id",
    "verifier_version",
    "scope",
    "disposition",
    "deterministic",
    "summary",
    "evidence",
    "created_at"
  ],
  "title": "VerifierResult",
  "type": "object"
}
