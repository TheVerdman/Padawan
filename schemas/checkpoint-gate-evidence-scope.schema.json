{
  "$id": "https://schemas.padawan.local/v1/checkpoint-gate-evidence-scope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Immutable study-result coordinates a checkpoint hard gate must verify.",
  "properties": {
    "checkpoint_id": {
      "minLength": 1,
      "title": "Checkpoint Id",
      "type": "string"
    },
    "condition_id": {
      "minLength": 1,
      "title": "Condition Id",
      "type": "string"
    },
    "gate_id": {
      "minLength": 1,
      "title": "Gate Id",
      "type": "string"
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "study_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Study Manifest Digest",
      "type": "string"
    },
    "study_result_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Study Result Digest",
      "type": "string"
    },
    "study_result_id": {
      "minLength": 1,
      "title": "Study Result Id",
      "type": "string"
    },
    "suite_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suite Manifest Digest",
      "type": "string"
    }
  },
  "required": [
    "gate_id",
    "study_id",
    "study_manifest_digest",
    "suite_manifest_digest",
    "condition_id",
    "checkpoint_id",
    "study_result_id",
    "study_result_digest"
  ],
  "title": "CheckpointGateEvidenceScope",
  "type": "object"
}
