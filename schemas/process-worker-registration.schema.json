{
  "$id": "https://schemas.padawan.local/v1/process-worker-registration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "broker_audience": {
      "minLength": 1,
      "title": "Broker Audience",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "credential_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Credential Digest",
      "type": "string"
    },
    "declared_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Declared Capabilities",
      "type": "array"
    },
    "execution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Digest",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "issuance_evidence": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Issuance Evidence",
      "type": "string"
    },
    "issued_by": {
      "minLength": 1,
      "title": "Issued By",
      "type": "string"
    },
    "role_id": {
      "minLength": 1,
      "title": "Role Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Scope Digest",
      "type": "string"
    },
    "worker_id": {
      "pattern": "^process-worker-[0-9a-f]{32}$",
      "title": "Worker Id",
      "type": "string"
    },
    "worker_model_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Worker Model Digest",
      "type": "string"
    }
  },
  "required": [
    "worker_id",
    "execution_digest",
    "authorization_digest",
    "scope_digest",
    "broker_audience",
    "role_id",
    "worker_model_digest",
    "declared_capabilities",
    "credential_digest",
    "issued_by",
    "issuance_evidence",
    "created_at",
    "expires_at"
  ],
  "title": "ProcessWorkerRegistration",
  "type": "object"
}
