{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ForensicArtifactRef": {
      "additionalProperties": false,
      "description": "Researcher-only reference; never part of a worker projection.",
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "classification_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Classification Digest",
          "type": "string"
        },
        "domain": {
          "const": "forensic",
          "default": "forensic",
          "title": "Domain",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "classification_digest"
      ],
      "title": "ForensicArtifactRef",
      "type": "object"
    },
    "ProcessRecoverySource": {
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "owner_type": {
          "minLength": 1,
          "title": "Owner Type",
          "type": "string"
        },
        "reference": {
          "$ref": "#/$defs/ForensicArtifactRef"
        }
      },
      "required": [
        "reference",
        "owner_type",
        "owner_id"
      ],
      "title": "ProcessRecoverySource",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/process-recovery-effect.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "after_phase": {
      "enum": [
        "reserved",
        "started",
        "settled",
        "released"
      ],
      "title": "After Phase",
      "type": "string"
    },
    "after_resource_event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "After Resource Event Digest",
      "type": "string"
    },
    "before_phase": {
      "enum": [
        "reserved",
        "started",
        "settled",
        "released"
      ],
      "title": "Before Phase",
      "type": "string"
    },
    "before_resource_event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Before Resource Event Digest",
      "type": "string"
    },
    "decision_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Decision Digest",
      "type": "string"
    },
    "decision_id": {
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "disposition": {
      "enum": [
        "released_unstarted",
        "completed_unadmitted",
        "unknown"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "invocation_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invocation Id"
    },
    "kind": {
      "enum": [
        "generic",
        "model",
        "container"
      ],
      "title": "Kind",
      "type": "string"
    },
    "observation_binding_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observation Binding Digest"
    },
    "observed_status": {
      "minLength": 1,
      "title": "Observed Status",
      "type": "string"
    },
    "reservation_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Reservation Digest",
      "type": "string"
    },
    "result_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result Digest"
    },
    "sources": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessRecoverySource"
      },
      "title": "Sources",
      "type": "array"
    },
    "worker_binding_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Binding Digest"
    },
    "workload_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workload Digest"
    }
  },
  "required": [
    "decision_id",
    "decision_digest",
    "reservation_digest",
    "before_phase",
    "after_phase",
    "before_resource_event_digest",
    "after_resource_event_digest",
    "disposition",
    "kind",
    "observed_status"
  ],
  "title": "ProcessRecoveryEffect",
  "type": "object"
}
