{
  "$id": "https://schemas.padawan.local/v1/atlas-phenomenon-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "behavioral_definition": {
      "minLength": 1,
      "title": "Behavioral Definition",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "exclusion_rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Exclusion Rules",
      "type": "array"
    },
    "inclusion_rules": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Inclusion Rules",
      "type": "array"
    },
    "manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Manifest Digest",
      "type": "string"
    },
    "ontology_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Ontology Digest",
      "type": "string"
    },
    "ontology_node_ids": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Ontology Node Ids",
      "type": "array"
    },
    "phenomenon_id": {
      "minLength": 1,
      "title": "Phenomenon Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "phenomenon_id",
    "ontology_digest",
    "title",
    "description",
    "ontology_node_ids",
    "behavioral_definition",
    "inclusion_rules",
    "exclusion_rules",
    "manifest_digest",
    "created_at"
  ],
  "title": "PhenomenonManifest",
  "type": "object"
}
