{
  "$defs": {
    "HypothesisStatus": {
      "enum": [
        "open",
        "supported",
        "rejected",
        "retired"
      ],
      "title": "HypothesisStatus",
      "type": "string"
    },
    "ProcessArtifactRef": {
      "additionalProperties": false,
      "description": "Worker-facing reference without forensic lineage or physical storage authority.",
      "properties": {
        "content_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Content Digest",
          "type": "string"
        },
        "domain": {
          "const": "process",
          "default": "process",
          "title": "Domain",
          "type": "string"
        },
        "execution_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Execution Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "process_artifact_id": {
          "pattern": "^process-artifact-[0-9a-f]{32}$",
          "title": "Process Artifact Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "process_artifact_id",
        "execution_digest",
        "content_digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ProcessArtifactRef",
      "type": "object"
    },
    "ProjectBudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": 0,
          "minimum": 0,
          "title": "Actions",
          "type": "integer"
        },
        "artifact_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "cost": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "wall_time_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Wall Time Seconds",
          "type": "number"
        }
      },
      "title": "ProjectBudgetUsage",
      "type": "object"
    },
    "ProjectClaim": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "minLength": 1,
          "title": "Claim Id",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "evidence_refs": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "statement",
        "confidence",
        "evidence_refs"
      ],
      "title": "ProjectClaim",
      "type": "object"
    },
    "ProjectDependency": {
      "additionalProperties": false,
      "properties": {
        "relation": {
          "minLength": 1,
          "title": "Relation",
          "type": "string"
        },
        "source_id": {
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "relation"
      ],
      "title": "ProjectDependency",
      "type": "object"
    },
    "ProjectHypothesis": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "hypothesis_id": {
          "minLength": 1,
          "title": "Hypothesis Id",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/HypothesisStatus"
        }
      },
      "required": [
        "hypothesis_id",
        "statement",
        "status"
      ],
      "title": "ProjectHypothesis",
      "type": "object"
    },
    "WorkerAssignment": {
      "additionalProperties": false,
      "properties": {
        "assignment_id": {
          "minLength": 1,
          "title": "Assignment Id",
          "type": "string"
        },
        "objective": {
          "minLength": 1,
          "title": "Objective",
          "type": "string"
        },
        "role_id": {
          "minLength": 1,
          "title": "Role Id",
          "type": "string"
        },
        "status": {
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "worker_identity": {
          "minLength": 1,
          "title": "Worker Identity",
          "type": "string"
        }
      },
      "required": [
        "assignment_id",
        "role_id",
        "worker_identity",
        "objective",
        "status"
      ],
      "title": "WorkerAssignment",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/process-worker-state.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Explicit allowlist, deliberately independent of the broker state envelope.",
  "properties": {
    "artifact_refs": {
      "items": {
        "$ref": "#/$defs/ProcessArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "budget_usage": {
      "$ref": "#/$defs/ProjectBudgetUsage"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/ProjectClaim"
      },
      "title": "Claims",
      "type": "array"
    },
    "dependencies": {
      "items": {
        "$ref": "#/$defs/ProjectDependency"
      },
      "title": "Dependencies",
      "type": "array"
    },
    "extension_state": {
      "additionalProperties": true,
      "propertyNames": {
        "minLength": 1
      },
      "title": "Extension State",
      "type": "object"
    },
    "hypotheses": {
      "items": {
        "$ref": "#/$defs/ProjectHypothesis"
      },
      "title": "Hypotheses",
      "type": "array"
    },
    "memory_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Memory Refs",
      "type": "array"
    },
    "objective": {
      "minLength": 1,
      "title": "Objective",
      "type": "string"
    },
    "plan": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Plan",
      "type": "array"
    },
    "unresolved_risks": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Unresolved Risks",
      "type": "array"
    },
    "worker_assignments": {
      "items": {
        "$ref": "#/$defs/WorkerAssignment"
      },
      "title": "Worker Assignments",
      "type": "array"
    }
  },
  "required": [
    "objective",
    "plan",
    "hypotheses",
    "claims",
    "artifact_refs",
    "dependencies",
    "budget_usage",
    "worker_assignments",
    "unresolved_risks",
    "memory_refs",
    "extension_state"
  ],
  "title": "ProcessWorkerState",
  "type": "object"
}
