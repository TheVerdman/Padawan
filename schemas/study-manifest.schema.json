{
  "$defs": {
    "ResearchAxis": {
      "enum": [
        "checkpoint",
        "quantization",
        "task",
        "parent_state",
        "harness",
        "continuation",
        "context_policy",
        "prompts",
        "tools",
        "budget",
        "serving",
        "auxiliary_models",
        "environment",
        "instrumentation",
        "seed"
      ],
      "title": "ResearchAxis",
      "type": "string"
    },
    "ResearchRole": {
      "enum": [
        "target",
        "baseline",
        "teacher",
        "verifier",
        "adjudicator"
      ],
      "title": "ResearchRole",
      "type": "string"
    },
    "StudyExperimentBinding": {
      "additionalProperties": false,
      "properties": {
        "assignment_propensity": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 1.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Assignment Propensity"
        },
        "checkpoint_id": {
          "minLength": 1,
          "title": "Checkpoint Id",
          "type": "string"
        },
        "condition_id": {
          "minLength": 1,
          "title": "Condition Id",
          "type": "string"
        },
        "environment_fingerprint": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Environment Fingerprint",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "factor_values": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "propertyNames": {
            "minLength": 1
          },
          "title": "Factor Values",
          "type": "object"
        },
        "research_execution_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Research Execution Digest"
        },
        "research_role": {
          "$ref": "#/$defs/ResearchRole"
        },
        "suite_manifest_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Suite Manifest Digest",
          "type": "string"
        }
      },
      "required": [
        "experiment_id",
        "condition_id",
        "checkpoint_id",
        "research_role",
        "suite_manifest_digest",
        "environment_fingerprint"
      ],
      "title": "StudyExperimentBinding",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/study-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_policy_id": {
      "minLength": 1,
      "title": "Aggregation Policy Id",
      "type": "string"
    },
    "aggregation_policy_version": {
      "minLength": 1,
      "title": "Aggregation Policy Version",
      "type": "string"
    },
    "comparison_axes": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ResearchAxis"
      },
      "title": "Comparison Axes",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "description": {
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "experiments": {
      "items": {
        "$ref": "#/$defs/StudyExperimentBinding"
      },
      "minItems": 1,
      "title": "Experiments",
      "type": "array"
    },
    "seed": {
      "title": "Seed",
      "type": "integer"
    },
    "study_id": {
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "suite_manifest_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Suite Manifest Digest",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "study_id",
    "version",
    "title",
    "description",
    "seed",
    "suite_manifest_digest",
    "aggregation_policy_id",
    "aggregation_policy_version",
    "experiments",
    "created_at"
  ],
  "title": "StudyManifest",
  "type": "object"
}
