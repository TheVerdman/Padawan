{
  "$defs": {
    "PersistenceMode": {
      "enum": [
        "episodic",
        "continual"
      ],
      "title": "PersistenceMode",
      "type": "string"
    },
    "ProcessEventKind": {
      "enum": [
        "project_started",
        "work_planned",
        "worker_invoked",
        "tool_invoked",
        "artifact_admitted",
        "hypothesis_updated",
        "claim_updated",
        "evidence_updated",
        "state_checkpointed",
        "rollout_forked",
        "outcome_assessed",
        "stop_requested",
        "project_completed",
        "project_failed"
      ],
      "title": "ProcessEventKind",
      "type": "string"
    },
    "ProjectBudgetUsage": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "default": 0,
          "minimum": 0,
          "title": "Actions",
          "type": "integer"
        },
        "artifact_bytes": {
          "default": 0,
          "minimum": 0,
          "title": "Artifact Bytes",
          "type": "integer"
        },
        "cost": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Cost",
          "type": "number"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "wall_time_seconds": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Wall Time Seconds",
          "type": "number"
        }
      },
      "title": "ProjectBudgetUsage",
      "type": "object"
    },
    "ProjectSplit": {
      "enum": [
        "train",
        "adaptive_development",
        "validation",
        "sealed"
      ],
      "title": "ProjectSplit",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/amber-action-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Authorization Digest",
      "type": "string"
    },
    "distribution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Distribution Digest",
      "type": "string"
    },
    "environment_fingerprint": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Environment Fingerprint",
      "type": "string"
    },
    "event_kind": {
      "$ref": "#/$defs/ProcessEventKind"
    },
    "lease_token_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Token Digest",
      "type": "string"
    },
    "persistence_mode": {
      "$ref": "#/$defs/PersistenceMode"
    },
    "program_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Program Digest",
      "type": "string"
    },
    "projected_artifact_bytes": {
      "default": 0,
      "minimum": 0,
      "title": "Projected Artifact Bytes",
      "type": "integer"
    },
    "projected_usage": {
      "$ref": "#/$defs/ProjectBudgetUsage"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "requested_destination": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requested Destination"
    },
    "role_id": {
      "minLength": 1,
      "title": "Role Id",
      "type": "string"
    },
    "rollout_id": {
      "minLength": 1,
      "title": "Rollout Id",
      "type": "string"
    },
    "rollout_sequence": {
      "minimum": 0,
      "title": "Rollout Sequence",
      "type": "integer"
    },
    "split": {
      "$ref": "#/$defs/ProjectSplit"
    },
    "state_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "State Digest",
      "type": "string"
    },
    "target_class": {
      "minLength": 1,
      "title": "Target Class",
      "type": "string"
    },
    "tool_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Digest"
    },
    "tool_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Id"
    },
    "tool_operation": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tool Operation"
    },
    "triggered_stop_conditions": {
      "default": [],
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Triggered Stop Conditions",
      "type": "array"
    },
    "worker_model_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Worker Model Digest",
      "type": "string"
    }
  },
  "required": [
    "authorization_digest",
    "rollout_id",
    "rollout_sequence",
    "state_digest",
    "lease_token_digest",
    "program_digest",
    "distribution_digest",
    "split",
    "persistence_mode",
    "event_kind",
    "role_id",
    "worker_model_digest",
    "target_class",
    "environment_fingerprint",
    "projected_usage",
    "requested_at"
  ],
  "title": "AmberActionRequest",
  "type": "object"
}
