{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "media_type": {
          "minLength": 1,
          "title": "Media Type",
          "type": "string"
        },
        "raw_data": {
          "default": false,
          "title": "Raw Data",
          "type": "boolean"
        },
        "restricted": {
          "default": false,
          "title": "Restricted",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "uri": {
          "pattern": "^artifact://sha256/[0-9a-f]{64}$",
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "uri",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ProcessEventKind": {
      "enum": [
        "project_started",
        "work_planned",
        "worker_invoked",
        "tool_invoked",
        "artifact_admitted",
        "hypothesis_updated",
        "claim_updated",
        "evidence_updated",
        "state_checkpointed",
        "rollout_forked",
        "outcome_assessed",
        "stop_requested",
        "project_completed",
        "project_failed"
      ],
      "title": "ProcessEventKind",
      "type": "string"
    },
    "RolloutStatus": {
      "enum": [
        "planned",
        "active",
        "paused",
        "review_required",
        "complete",
        "failed",
        "quarantined",
        "cancelled"
      ],
      "title": "RolloutStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.padawan.local/v1/process-event.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor_id": {
      "minLength": 1,
      "title": "Actor Id",
      "type": "string"
    },
    "amber_authorization_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Amber Authorization Digest",
      "type": "string"
    },
    "amber_decision_id": {
      "minLength": 1,
      "title": "Amber Decision Id",
      "type": "string"
    },
    "artifact_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Artifact Refs",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "event_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Event Digest",
      "type": "string"
    },
    "event_id": {
      "minLength": 1,
      "title": "Event Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ProcessEventKind"
    },
    "lease_token_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Lease Token Digest",
      "type": "string"
    },
    "parent_state_id": {
      "minLength": 1,
      "title": "Parent State Id",
      "type": "string"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "research_execution_digest": {
      "anyOf": [
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Research Execution Digest"
    },
    "resulting_state_id": {
      "minLength": 1,
      "title": "Resulting State Id",
      "type": "string"
    },
    "rollout_id": {
      "minLength": 1,
      "title": "Rollout Id",
      "type": "string"
    },
    "rollout_status": {
      "$ref": "#/$defs/RolloutStatus"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "worker_invocation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Worker Invocation Id"
    }
  },
  "required": [
    "event_id",
    "rollout_id",
    "sequence",
    "kind",
    "actor_id",
    "lease_token_digest",
    "parent_state_id",
    "resulting_state_id",
    "amber_authorization_digest",
    "amber_decision_id",
    "rollout_status",
    "payload",
    "event_digest",
    "created_at"
  ],
  "title": "ProcessEventRecord",
  "type": "object"
}
