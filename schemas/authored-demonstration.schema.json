{
  "$defs": {
    "AuthoredMessage": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "enum": [
            "developer",
            "system",
            "user",
            "assistant",
            "tool"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "content"
      ],
      "title": "AuthoredMessage",
      "type": "object"
    },
    "AuthoredTargetEvent": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "role": {
          "const": "assistant",
          "default": "assistant",
          "title": "Role",
          "type": "string"
        },
        "type": {
          "const": "assistant_message",
          "default": "assistant_message",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "AuthoredTargetEvent",
      "type": "object"
    },
    "DistributionScope": {
      "enum": [
        "internal_only",
        "agreement_restricted",
        "redistributable"
      ],
      "title": "DistributionScope",
      "type": "string"
    },
    "RightsBasis": {
      "enum": [
        "project_authored",
        "public_domain",
        "open_license",
        "contract_authorized",
        "fair_use_reviewed",
        "provider_terms",
        "unknown"
      ],
      "title": "RightsBasis",
      "type": "string"
    },
    "RightsReviewStatus": {
      "enum": [
        "confirmed",
        "review_required",
        "prohibited"
      ],
      "title": "RightsReviewStatus",
      "type": "string"
    },
    "RightsUse": {
      "enum": [
        "evidence_retention",
        "internal_research",
        "evaluation",
        "continued_pretraining",
        "sft",
        "preference",
        "rlvr",
        "process",
        "redistribution"
      ],
      "title": "RightsUse",
      "type": "string"
    },
    "SourceRights": {
      "additionalProperties": false,
      "description": "Versioned use authority; this is governance evidence, not a legal conclusion.",
      "properties": {
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attribution"
        },
        "basis": {
          "$ref": "#/$defs/RightsBasis"
        },
        "basis_detail": {
          "minLength": 1,
          "title": "Basis Detail",
          "type": "string"
        },
        "distribution_scope": {
          "$ref": "#/$defs/DistributionScope"
        },
        "license_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "License Id"
        },
        "permitted_uses": {
          "items": {
            "$ref": "#/$defs/RightsUse"
          },
          "title": "Permitted Uses",
          "type": "array"
        },
        "restrictions": {
          "default": [],
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "title": "Restrictions",
          "type": "array"
        },
        "review_status": {
          "$ref": "#/$defs/RightsReviewStatus"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "rights_id": {
          "minLength": 1,
          "title": "Rights Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "terms_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Digest"
        },
        "terms_uri": {
          "anyOf": [
            {
              "pattern": "^https://[^\\s]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Terms Uri"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "rights_id",
        "version",
        "basis",
        "basis_detail",
        "permitted_uses",
        "distribution_scope",
        "review_status"
      ],
      "title": "SourceRights",
      "type": "object"
    }
  },
  "$id": "https://schemas.padawan.local/v1/authored-demonstration.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Governed gold behavior that is explicitly not an observed student attempt.",
  "properties": {
    "authored_by": {
      "minLength": 1,
      "title": "Authored By",
      "type": "string"
    },
    "competency_id": {
      "minLength": 1,
      "title": "Competency Id",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "demonstration_id": {
      "minLength": 1,
      "title": "Demonstration Id",
      "type": "string"
    },
    "domain_id": {
      "minLength": 1,
      "title": "Domain Id",
      "type": "string"
    },
    "final_answer": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "string"
        }
      ],
      "title": "Final Answer"
    },
    "messages": {
      "items": {
        "$ref": "#/$defs/AuthoredMessage"
      },
      "minItems": 1,
      "title": "Messages",
      "type": "array"
    },
    "prompt": {
      "minLength": 1,
      "title": "Prompt",
      "type": "string"
    },
    "quality_evidence_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Quality Evidence Refs",
      "type": "array"
    },
    "reviewed_by": {
      "minLength": 1,
      "title": "Reviewed By",
      "type": "string"
    },
    "rights": {
      "$ref": "#/$defs/SourceRights"
    },
    "rights_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Rights Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_item_id": {
      "minLength": 1,
      "title": "Source Item Id",
      "type": "string"
    },
    "target_events": {
      "items": {
        "$ref": "#/$defs/AuthoredTargetEvent"
      },
      "minItems": 1,
      "title": "Target Events",
      "type": "array"
    },
    "verification_scope": {
      "minLength": 1,
      "title": "Verification Scope",
      "type": "string"
    },
    "verifier_result_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Verifier Result Digest",
      "type": "string"
    },
    "verifier_result_id": {
      "minLength": 1,
      "title": "Verifier Result Id",
      "type": "string"
    }
  },
  "required": [
    "demonstration_id",
    "domain_id",
    "competency_id",
    "source_item_id",
    "verification_scope",
    "messages",
    "prompt",
    "target_events",
    "final_answer",
    "verifier_result_id",
    "verifier_result_digest",
    "rights",
    "rights_digest",
    "quality_evidence_refs",
    "authored_by",
    "reviewed_by",
    "created_at"
  ],
  "title": "AuthoredDemonstration",
  "type": "object"
}
