{
  "$id": "https://schemas.padawan.local/v1/process-artifact-reference.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Worker-facing reference without forensic lineage or physical storage authority.",
  "properties": {
    "content_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Content Digest",
      "type": "string"
    },
    "domain": {
      "const": "process",
      "default": "process",
      "title": "Domain",
      "type": "string"
    },
    "execution_digest": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "title": "Execution Digest",
      "type": "string"
    },
    "media_type": {
      "minLength": 1,
      "title": "Media Type",
      "type": "string"
    },
    "process_artifact_id": {
      "pattern": "^process-artifact-[0-9a-f]{32}$",
      "title": "Process Artifact Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "size_bytes": {
      "minimum": 0,
      "title": "Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "process_artifact_id",
    "execution_digest",
    "content_digest",
    "media_type",
    "size_bytes"
  ],
  "title": "ProcessArtifactRef",
  "type": "object"
}
