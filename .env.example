PADAWAN_DATABASE_URL=postgresql+psycopg://padawan:padawan-local-only@localhost:5432/padawan
PADAWAN_ARTIFACT_BACKEND=local
PADAWAN_ARTIFACT_ROOT=./artifacts
# PADAWAN_GCS_PROJECT=your-project-id
# PADAWAN_GCS_BUCKET=your-bucket
PADAWAN_GCS_PREFIX=padawan/artifacts
PADAWAN_GCS_TIMEOUT_SECONDS=60
PADAWAN_DOMAIN_ID=math.algebra
PADAWAN_LEAN_PROJECT_ROOT=./lean
PADAWAN_LEAN_LAKE_EXECUTABLE=./.tools/elan/bin/lake
PADAWAN_LEAN_ELAN_HOME=./.tools/elan
PADAWAN_LEAN_SANDBOX_MODE=required
PADAWAN_LEAN_TIMEOUT_SECONDS=20
PADAWAN_LEAN_OUTPUT_LIMIT_BYTES=262144
PADAWAN_LEAN_MEMORY_LIMIT_MB=4096
# PADAWAN_MAGELLAN_REPOSITORY_ROOT=/path/to/magellan
# PADAWAN_MAGELLAN_HANDSHAKE_PATH=/path/to/magellan-handshake.json
PADAWAN_LOG_LEVEL=INFO
PADAWAN_ENVIRONMENT=development
PADAWAN_CODE_REVISION=unknown
PADAWAN_WORKER_ID=local-worker
PADAWAN_LEASE_SECONDS=300
PADAWAN_HEARTBEAT_SECONDS=15
PADAWAN_EXTERNAL_TIMEOUT_SECONDS=120
PADAWAN_EXTERNAL_RETRY_ATTEMPTS=3
# PADAWAN_OPENAI_MODEL=gpt-5.6-sol
PADAWAN_OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=replace-me
# PADAWAN_ANTHROPIC_MODEL=claude-opus-5
PADAWAN_ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=replace-me
PADAWAN_INKLING_BASE_URL=http://127.0.0.1:8000
# PADAWAN_INKLING_MODEL=w8a16-balanced-v1
# INKLING_API_KEY=secret-manager-supplied-value
PADAWAN_INKLING_RUNTIME_REVISION=aa2e7dd0f8f5fd1be0e4449f802ae5b72ffc534a
# Set at least one expected identity. The edge capability response must report and match it.
# PADAWAN_INKLING_EDGE_IMAGE_DIGEST=sha256:replace-with-64-lowercase-hex-characters
# PADAWAN_INKLING_EDGE_DEPLOYMENT_REVISION=inkling-responses-edge-revision
PADAWAN_INKLING_TENSOR_PARALLEL_SIZE=4
PADAWAN_INKLING_TIMEOUT_SECONDS=3600
# PADAWAN_COMPATIBLE_BASE_URL=https://your-compatible-endpoint.example
# PADAWAN_COMPATIBLE_MODEL=your-compatible-model
# PADAWAN_COMPATIBLE_API_KEY=secret-manager-supplied-value
# PADAWAN_RAW_ARTIFACT_RETENTION_DAYS=30
PADAWAN_RUN_RETRY_BUDGET=3
PADAWAN_EXPORT_PRIVATE_REASONING=false
# PADAWAN_EXPORT_HMAC_KEY belongs in a secret manager, not this file.
